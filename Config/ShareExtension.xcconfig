// The share extension: Usual Bot in the share sheet and the Mac's Share menu. It leaves what you
// share in the App Group folder for the app to send.
// The project's Debug or Release config (and so Shared.xcconfig) still applies underneath.

PRODUCT_NAME = UsualBotShare
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).UsualBot.Share
INFOPLIST_FILE = Config/ShareExtension-Info.plist
// The name in the share sheet.
INFOPLIST_KEY_CFBundleDisplayName = Usual Bot
INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphone*] = NO
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone[sdk=iphone*] =
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad[sdk=iphone*] =
INFOPLIST_KEY_LSApplicationCategoryType =
ASSETCATALOG_COMPILER_APPICON_NAME =
SKIP_INSTALL = YES
ENABLE_PREVIEWS = NO
APPLICATION_EXTENSION_API_ONLY = YES

// Empty unless scripts/testflight.sh signs with profiles made beforehand.
PROVISIONING_PROFILE_SPECIFIER = $(USUAL_SHARE_PROFILE)

CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/ShareExtension-macOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = Config/ShareExtension-iOS.entitlements

LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=iphone*] = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks
