// Build settings shared by every configuration of the UsualBot app target.
// Your signing team and bundle prefix go in Local.xcconfig (gitignored); see Local.xcconfig.example.

PRODUCT_NAME = UsualBot
INFOPLIST_KEY_CFBundleDisplayName = Usual Bot
INFOPLIST_KEY_NSHumanReadableCopyright = An independent app, not made by, affiliated with or endorsed by Nous Research.
MARKETING_VERSION = 0.4.0
CURRENT_PROJECT_VERSION = 1

BUNDLE_ID_PREFIX = dev.usualbot.local
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).UsualBot

SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1,2
MACOSX_DEPLOYMENT_TARGET = 26.0
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphone*] = YES
// The launch screen (the Hermes mark on the window colour) is UILaunchScreen in Config/Info.plist.
// iOS asks before the app reaches a gateway on the home network (a tailnet address needs no prompt).
INFOPLIST_KEY_NSLocalNetworkUsageDescription[sdk=iphone*] = Usual Bot connects to your Hermes gateway on your home network.
INFOPLIST_KEY_NSCameraUsageDescription[sdk=iphone*] = Take a photo to send to a Bot.
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone[sdk=iphone*] = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad[sdk=iphone*] = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// App/Assets.xcassets: the Hermes doodle on white, rounded by the system on both platforms.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_STYLE = Automatic
// Empty unless scripts/testflight.sh signs with profiles made beforehand; the notification
// extension takes its own in NotificationService.xcconfig.
PROVISIONING_PROFILE_SPECIFIER = $(USUAL_APP_PROFILE)
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = $(USUAL_MAC_ENTITLEMENTS_$(USUAL_PUSH))
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = $(USUAL_IOS_ENTITLEMENTS_$(USUAL_PUSH))
USUAL_MAC_ENTITLEMENTS_NO = Config/UsualBot-macOS.entitlements
USUAL_MAC_ENTITLEMENTS_YES = Config/UsualBot-macOS-Push.entitlements
USUAL_IOS_ENTITLEMENTS_NO =
USUAL_IOS_ENTITLEMENTS_YES = Config/UsualBot-iOS-Push.entitlements
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=iphone*] = $(inherited) @executable_path/Frameworks

ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Push notifications through Usual's relay (Services/push-relay). Off by default: they need a paid
// team with Push Notifications on for the bundle ID, so CI, unsigned and forked builds go without.
// Set USUAL_PUSH = YES in Local.xcconfig or on the command line. A fork with its own relay sets
// USUAL_PUSH_RELAY_URL_YES too. The entitlements say "development": exporting for TestFlight or the
// App Store makes it production, and the app reads which from its profile (PushRelay).
USUAL_PUSH = NO
USUAL_PUSH_RELAY_URL = $(USUAL_PUSH_RELAY_URL_$(USUAL_PUSH))
USUAL_PUSH_RELAY_URL_NO =
USUAL_PUSH_RELAY_URL_YES = https:/$()/push.usual.dev
// Shared with the notification extension, which opens what the gateway sealed.
USUAL_PUSH_KEYCHAIN_GROUP = $(DEVELOPMENT_TEAM).$(BUNDLE_ID_PREFIX).UsualBot.push

#include? "Local.xcconfig"
