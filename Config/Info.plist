<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode can't generate from INFOPLIST_KEY_* build settings. -->
	<!-- Dictation in the message box. In this file, not Shared.xcconfig: Xcode doesn't generate
	     NSSpeechRecognitionUsageDescription for macOS, and macOS stops an app that asks without it. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<!-- A chat dragged between sidebar sections. Its own type, so dropping one on the message box
		     or in another app does nothing rather than pasting an ID. -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.usualbot.sidebar-chat</string>
			<key>UTTypeDescription</key>
			<string>Usual Bot chat</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate messages to your agents.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you say into message text, on this device when it can.</string>
	<!-- iPhone launch screen: the Hermes mark centred on the window colour (App/Assets.xcassets), which
	     the app's splash view continues while it reads the saved sign-in. Ignored on the Mac. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Many gateways are plain http on a tailnet or home network (e.g. http://100.101.102.103:9119).
		     ATS has no exception for Tailscale's 100.64.0.0/10 range, so the app enforces the rule itself:
		     GatewayAddress refuses plain http to any public host before a request is made.
		     Don't add NSAllowsLocalNetworking here: alongside it, ATS ignores this key. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
