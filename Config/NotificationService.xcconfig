// The notification extension: opens what the gateway sealed for this device.
// The project's Debug or Release config (and so Shared.xcconfig) still applies underneath.

PRODUCT_NAME = UsualBotNotifications
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).UsualBot.NotificationService
INFOPLIST_FILE = Config/NotificationService-Info.plist
INFOPLIST_FILE[sdk=macosx*] = Config/NotificationService-Info-macOS.plist
INFOPLIST_KEY_CFBundleDisplayName = Usual Bot Notifications
INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphone*] = NO
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone[sdk=iphone*] =
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad[sdk=iphone*] =
INFOPLIST_KEY_LSApplicationCategoryType =
ASSETCATALOG_COMPILER_APPICON_NAME =
SKIP_INSTALL = YES
ENABLE_PREVIEWS = NO
APPLICATION_EXTENSION_API_ONLY = YES

// Push builds (USUAL_PUSH, in Shared.xcconfig) share a keychain group with the app.
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = $(USUAL_NSE_MAC_ENTITLEMENTS_$(USUAL_PUSH))
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = $(USUAL_NSE_IOS_ENTITLEMENTS_$(USUAL_PUSH))
USUAL_NSE_MAC_ENTITLEMENTS_NO = Config/NotificationService-macOS.entitlements
USUAL_NSE_MAC_ENTITLEMENTS_YES = Config/NotificationService-macOS-Push.entitlements
USUAL_NSE_IOS_ENTITLEMENTS_NO =
USUAL_NSE_IOS_ENTITLEMENTS_YES = Config/NotificationService-iOS-Push.entitlements

LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=iphone*] = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks
